{
  "manifest_version": 3,
  "name": "ACM Studio — Accès annonces",
  "version": "1.0.0",
  "description": "Lit, à la demande du conseiller, les annonces immobilières des portails pour ACM Studio. Ne stocke rien, n'envoie rien ailleurs.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "https://seloger.com/*",
    "https://*.seloger.com/*",
    "https://bienici.com/*",
    "https://*.bienici.com/*",
    "https://green-acres.fr/*",
    "https://*.green-acres.fr/*",
    "https://immobilier.lefigaro.fr/*",
    "https://maisonsetappartements.fr/*",
    "https://*.maisonsetappartements.fr/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://acm-studio-henna.vercel.app/*",
      "https://acm-studio-essai.vercel.app/*",
      "http://localhost:3000/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://acm-studio-henna.vercel.app/*",
        "https://acm-studio-essai.vercel.app/*",
        "http://localhost:3000/*"
      ],
      "js": ["content-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
