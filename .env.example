NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# URL publique de cet environnement (liens d'invitation) : travail, essai ou http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
# Adresse d'installation de l'extension Chrome (Chrome Web Store, non répertoriée). Vide : le message
# renvoie le conseiller vers son agence.
NEXT_PUBLIC_EXTENSION_INSTALL_URL=
# Identifiant de l'extension ACM publiée (Chrome Web Store) : podbdogdackjabnpnngndpkdnhfakfgb.
# Sert à reconnaître une extension installée mais sans accès au site (mission 105). Vide : le
# message reste « Installer l'extension ».
NEXT_PUBLIC_EXTENSION_ID=
# Identifiant de l'extension Localisateur Academia (adresses des concurrents, mission 75). Vide : ACM
# Studio se comporte comme si le Localisateur n'était pas installé.
NEXT_PUBLIC_LOCALISATEUR_ID=
# Comptes qui exploitent l'outil (page « Erreurs », plafonds de recherche) : adresses e-mail
# séparées par des virgules. Vide : personne (mission 100). Jamais préfixée NEXT_PUBLIC_.
ACM_OPERATOR_EMAILS=
# Jeton de la tâche planifiée de la nuit (revérification des oppositions, mission 105) : au moins
# 16 caractères, défini dans Vercel ; Vercel Cron l'envoie. Vide : la tâche est refusée.
CRON_SECRET=
