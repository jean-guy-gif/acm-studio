{
  "name": "acm-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "pdfjs:assets": "node scripts/copy-pdfjs-assets.mjs",
    "demo:photos": "node scripts/demo-photo-sets.mjs",
    "postinstall": "npm run pdfjs:assets",
    "predev": "npm run pdfjs:assets && npm run demo:photos",
    "dev": "next dev",
    "prebuild": "npm run pdfjs:assets && npm run demo:photos",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretypecheck": "npm run demo:photos",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run demo:photos",
    "test": "vitest run",
    "gen:types": "npx --yes supabase@3.0.0 gen types typescript --schema public > src/lib/supabase/database.types.ts && prettier --ignore-path /dev/null --write src/lib/supabase/database.types.ts",
    "e2e": "playwright test",
    "banc:etude": "node tests/print/banc.mjs",
    "e2e:demo": "playwright test tests/e2e/demo.spec.ts",
    "extension:icons": "node scripts/extension-icons.mjs",
    "extension:zip": "node scripts/extension-zip.mjs",
    "sauvegarde": "node scripts/sauvegarde.mjs",
    "sauvegarde:verifier": "node scripts/sauvegarde-verifier.mjs",
    "nettoyer:test": "node scripts/nettoyer-test.mjs",
    "verifier:production": "node scripts/verifier-production.mjs",
    "atelier": "node atelier/serveur.mjs --ouvrir",
    "cle-adresse": "node --experimental-strip-types --no-warnings scripts/cle-adresse.mjs",
    "demo:fiches": "node --experimental-strip-types --no-warnings scripts/demo-fiches.mjs"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "0.36.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "next": "16.2.10",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prettier": "^3.9.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
